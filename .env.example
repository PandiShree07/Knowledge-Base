# Gemini
GEMINI_API_KEY=put_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Runtime app account: use the read-only account created by sql/01_create_demo_database.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uka_demo
DB_USER=uka_demo_reader
DB_PASSWORD=change_me_reader_password

# Used ONLY by scripts/seed_demo_data.py to seed the separate demo database.
# Never point this at your real/production database.
SEED_DB_HOST=127.0.0.1
SEED_DB_PORT=3306
SEED_DB_NAME=uka_demo
SEED_DB_USER=uka_demo_seed
SEED_DB_PASSWORD=change_me_seed_password
